                          return ERROR;
                      }
                      */
              
                      /*  如果MCU不支持多进程或多线程，使用此函数时每次只发一包（数据长度�
             -��大于STREM_PACK_LEN），
                      发送完之后在 stream_trans_send_result 函数中处理模块返回的结果，发送成功时
             -再次调用此函数发送下一包，注意包偏移要增加  */
                  }
              
                  return SUCCESS;
              }
              
