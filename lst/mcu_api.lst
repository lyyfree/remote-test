  33          u8 hex_to_bcd(u8 Value_H, u8 Value_L) {
  34   1          u8 bcd_value;
  35   1      
  36   1          if ((Value_H >= '0') && (Value_H <= '9'))
  37   1              Value_H -= '0';
  38   1          else if ((Value_H >= 'A') && (Value_H <= 'F'))
  39   1              Value_H = Value_H - 'A' + 10;
  40   1          else if ((Value_H >= 'a') && (Value_H <= 'f'))
  41   1              Value_H = Value_H - 'a' + 10;
  42   1      
  43   1          bcd_value = Value_H & 0x0f;
  44   1      
  45   1          bcd_value <<= 4;
  46   1          if ((Value_L >= '0') && (Value_L <= '9'))
  47   1              Value_L -= '0';
  48   1          else if ((Value_L >= 'A') && (Value_L <= 'F'))
  49   1              Value_L = Value_L - 'a' + 10;
  50   1          else if ((Value_L >= 'a') && (Value_L <= 'f'))
  51   1              Value_L = Value_L - 'a' + 10;
  52   1      
