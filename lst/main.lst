 224          /**
 225           * 查找表：功率(0.1W) → mcu_duty
 226           * 数据来源：你的实测结果，按功率从小到大排列
 227           * 注：mcu_duty越大，导通角越小，功率越低
 228           */
 229          typedef struct
 230          {
 231            u16 p_01w;   // 功率，单位0.1W（100=10.0W，450=45.0W）
 232            u8 mcu_duty; // MCU内部占空比（0~100，≤58时功率≥10W，稳定）
 233          } P2Duty_LUT_t;
 234          
 235          P2Duty_LUT_t xdata p2duty_lut[] = {
 236            {100, 60}, // 10.0W → 稳定下限，对应d_wifi=1时的目标功率
 237            {136, 55}, // 13.6W
 238            {171, 50}, // 17.1W
C51 COMPILER V9.60.7.0   MAIN                                                              11/14/2026 00:42:13 PAGE 5   

 239            {230, 45}, // 23.0W
 240            {275, 40}, // 27.5W
 241            {308, 35}, // 30.8W
 242            {342, 30}, // 34.2W
 243            {376, 25}, // 37.6W
 244            {397, 20}, // 39.7W
 245            {410, 15}, // 41.0W
 246            {436, 10}, // 43.6W
 247            {480, 0},  // 48.0W → 目标上限，实测全通时为48W，此处对齐目标
 248          };
 249          #define LUT_SIZE (sizeof(p2duty_lut) / sizeof(p2duty_lut[0]))
 250          
 251          /**
 252           * @brief 根据WiFi占空比计算目标功率（线性映射）
 253           * @param d_wifi: 来自WiFi的占空比（1~100）
 254           * @return 目标功率，单位0.1W（100~480）
 255           */
 256          static u16 calc_target_power(u8 d_wifi)
 257          {
 258   1        u32 p_target_temp = 0;
 259   1        // 输入健壮性处理（无限制，仅防止极端值）
 260   1        if (d_wifi < 1)
 261   1          d_wifi = 1;
 262   1        if (d_wifi > 100)
 263   1          d_wifi = 100;
 264   1      
 265   1        // P_target = 10W + (48W-10W)*(d_wifi-1)/(100-1)
 266   1        // 放大10倍转整数运算：100 + 350*(d_wifi-1)/99
 267   1        p_target_temp = 100 + (380 * (d_wifi - 1)) / 99;
 268   1      
 269   1        // 硬件上限钳位：实测最大功率为48W，无法突破48W，此处对齐目标
 270   1        if (p_target_temp > 480)
 271   1          p_target_temp = 480;
 272   1      
 273   1        return (u16)p_target_temp;
 274   1      }
 275          
 276          /**
 277           * @brief 根据目标功率反查MCU占空比（基于实测数据插值）
 278           * @param target_p_01w: 目标功率，单位0.1W
 279           * @return MCU内部占空比（0~58，保证功率≥10W，稳定）
 280           */
 281          static u8 get_mcu_duty_by_power(u16 target_p_01w)
 282          {
 283   1        u8 i;
 284   1        u8 d_low, d_high;
 285   1        u16 p_low, p_high;
 286   1        u32 mcu_duty = 0;
 287   1        // 边界1：功率≤10W，返回最大稳定占空比58
 288   1        if (target_p_01w <= p2duty_lut[0].p_01w)
 289   1        {
 290   2          return p2duty_lut[0].mcu_duty;
 291   2        }
 292   1        // 边界2：功率≥48W，返回最小占空比0（全通）
 293   1        if (target_p_01w >= p2duty_lut[LUT_SIZE - 1].p_01w)
 294   1        {
 295   2          return p2duty_lut[LUT_SIZE - 1].mcu_duty;
 296   2        }
 297   1      
 298   1        // 查找功率所在的插值区间（按功率升序排列）
 299   1        for (i = 0; i < LUT_SIZE - 1; i++)
 300   1        {
C51 COMPILER V9.60.7.0   MAIN                                                              11/14/2026 00:42:13 PAGE 6   

 301   2          if (target_p_01w >= p2duty_lut[i].p_01w &&
 302   2            target_p_01w <= p2duty_lut[i + 1].p_01w)
 303   2          {
 304   3            p_low = p2duty_lut[i].p_01w;
 305   3            p_high = p2duty_lut[i + 1].p_01w;
 306   3            d_low = p2duty_lut[i].mcu_duty;
 307   3            d_high = p2duty_lut[i + 1].mcu_duty;
 308   3            break;
 309   3          }
 310   2        }
 311   1      
 312   1        /**
 313   1         * 线性插值（功率↑ → mcu_duty↓，反向关系）
 314   1         * 公式：d = d_low - (target_p - p_low) * (d_low - d_high) / (p_high - p_low)
 315   1         * 例：target_p=167（16.7W），介于171(17.1W, d=50)和136(13.6W, d=55)之间
 316   1         * d=50 - (167-136)*(50-55)/(171-136) = 50 - 31*(-5)/35 ≈ 54.4
 317   1         */
 318   1        mcu_duty = d_low;
 319   1        if (p_high != p_low)
 320   1        { // 避免除零
 321   2          mcu_duty -= (u32)(target_p_01w - p_low) * (d_low - d_high) / (p_high - p_low);
 322   2        }
 323   1      
 324   1        // 最终钳位：最大占空比不超过60（保证功率≥10W，稳定）
 325   1        if (mcu_duty > p2duty_lut[0].mcu_duty)
 326   1        {
 327   2          mcu_duty = p2duty_lut[0].mcu_duty;
 328   2        }
 329   1        // 最小占空比不低于0
 330   1        if (mcu_duty > 100)
 331   1          mcu_duty = 100; // 溢出保护
 332   1      
 333   1        return (u8)mcu_duty;
 334   1      }
