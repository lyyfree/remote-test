 508   3              (turn_off_time > DAY_SECONDS && sys_time >= (turn_off_time % DAY_SECONDS) && day_flag))
 509   3            {
 510   4              emLightState = emLightState_Off;
 511   4              emTimeState = emTimeState_Off;
 512   4              turn_on_time = 0;
 513   4              turn_off_time = 0;
 514   4              if (day_flag == 1)
 515   4              {
 516   5                day_flag = 0;
 517   5              }
 518   4              all_data_update();
 519   4            }
 520   3          }
 521   2      
 522   2        }
 523   1      }
