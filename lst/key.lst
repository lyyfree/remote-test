  58   2              else
  59   2              {
  60   3                  // 10ms内变回高电平=抖动，回到空闲
  61   3                  key->state = KEY_IDLE;
  62   3              }
  63   2              break;
  64   2      
  65   2          /* ------------------- 稳定按下：计时+判断长按 ------------------- */
  66   2          case KEY_PRESS_HOLD:
