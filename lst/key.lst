  44   3              }
  45   2              break;
  46   2      
  47   2          /* ------------------- 按下消抖：过滤抖动 ------------------- */
  48   2          case KEY_PRESS_DEBOUNCE:
  49   2              if (cur_level == 0)
  50   2              {
  51   3                  key->debounce_cnt++;
  52   3                  if (key->debounce_cnt >= 2)
  53   3                  { // 连续10ms都是低电平=真按下
  54   4                      key->state = KEY_PRESS_HOLD;
