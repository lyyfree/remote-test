  58          /**
  59           * @brief  计算校验和
  60           * @param[in] {pack} 数据源指针
  61           * @param[in] {pack_len} 计算校验和长度
  62           * @return 校验和
  63           */
  64          u8 get_check_sum(u8 *pack, u16 pack_len) {
  65   1          u16 i;
  66   1          u8 check_sum = 0;
  67   1      
  68   1          for (i = 0; i < pack_len; i++) {
  69   2              check_sum += *pack++;
  70   2          }
  71   1      
  72   1          return check_sum;
  73   1      }
