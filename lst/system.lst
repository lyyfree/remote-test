  78           * @param[in] {len} 数据发送长度
  79           * @return Null
  80           */
  81          static void wifi_uart_write_data(u8 *in, u16 len) {
  82   1          if ((NULL == in) || (0 == len)) {
  83   2              return;
  84   2          }
  85   1      
  86   1          while (len--) {
  87   2              uart_transmit_output(*in);
  88   2              in++;
  89   2          }
  90   1      }
  91          
  92          /**
  93           * @brief  向wifi串口发送一帧数据
  94           * @param[in] {fr_type} 帧类型
  95           * @param[in] {fr_ver} 帧版本
  96           * @param[in] {len} 数据长度
  97           * @return Null
  98           */
  99          void wifi_uart_write_frame(u8 fr_type, u8 fr_ver, u16 len) {
 100   1          u8 check_sum = 0;
 101   1      
 102   1          wifi_uart_tx_buf[HEAD_FIRST] = 0x55;
 103   1          wifi_uart_tx_buf[HEAD_SECOND] = 0xaa;
 104   1          wifi_uart_tx_buf[PROTOCOL_VERSION] = fr_ver;
 105   1          wifi_uart_tx_buf[FRAME_TYPE] = fr_type;
 106   1          wifi_uart_tx_buf[LENGTH_HIGH] = len >> 8;
 107   1          wifi_uart_tx_buf[LENGTH_LOW] = len & 0xff;
 108   1      
 109   1          len += PROTOCOL_HEAD;
 110   1          check_sum = get_check_sum((u8 *)wifi_uart_tx_buf, len - 1);
 111   1          wifi_uart_tx_buf[len - 1] = check_sum;
 112   1      
 113   1          wifi_uart_write_data((u8 *)wifi_uart_tx_buf, len);
 114   1      }
